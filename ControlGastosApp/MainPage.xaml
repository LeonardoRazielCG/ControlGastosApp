<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ControlGastosApp.ViewModels"
             x:Class="ControlGastosApp.Views.MainPage"
             BackgroundColor="#121212">

    <Grid RowDefinitions="Auto, *">

        <Frame Grid.Row="0" 
               BackgroundColor="#1E1E1E" 
               CornerRadius="15" 
               Margin="20" 
               Padding="20"
               HasShadow="True">
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCapitalTarjetaTapped"/>
            </Frame.GestureRecognizers>

            <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="Capital Total" TextColor="Gray" FontSize="14" HorizontalOptions="Center"/>
                <Label Text="{Binding CapitalTotal, StringFormat='${0:F2}'}" 
                       TextColor="White" 
                       FontSize="36" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center" 
                       Margin="0,5"/>
                <Label Text="(Toca para modificar)" TextColor="#512BD4" FontSize="12" HorizontalOptions="Center"/>
            </StackLayout>
        </Frame>

        <CarouselView Grid.Row="1" 
                      x:Name="carouselViews" 
                      ItemsSource="{Binding Secciones}" 
                      Margin="0,10,0,0">
            <CarouselView.ItemTemplate>
                <DataTemplate>
                    <Grid RowDefinitions="Auto, *">

                        <Label Text="{Binding Titulo}" 
                               TextColor="White" 
                               FontSize="20" 
                               Margin="25,0" 
                               FontAttributes="Bold"/>

                        <ListView Grid.Row="1" 
                                  Margin="10" 
                                  BackgroundColor="Transparent"
                                  SelectionMode="None"
                                  ItemsSource="{Binding Items}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ViewCell>
                                        <Grid ColumnDefinitions="*, Auto" 
                                              Padding="15,10" 
                                              BackgroundColor="#1E1E1E" 
                                              Margin="0,2">

                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnMovimientoTapped" 
                                                                      CommandParameter="{Binding .}"/>
                                            </Grid.GestureRecognizers>

                                            <Label Grid.Column="0" 
                                                   Text="{Binding Concepto}" 
                                                   TextColor="White" 
                                                   FontSize="16" 
                                                   VerticalOptions="Center"/>

                                            <Label Grid.Column="1" 
                                                   Text="{Binding Monto, StringFormat='${0:F2}'}" 
                                                   FontSize="16" 
                                                   FontAttributes="Bold" 
                                                   VerticalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding EsIngreso}" Value="True">
                                                        <Setter Property="TextColor" Value="#4CAF50" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding EsIngreso}" Value="False">
                                                        <Setter Property="TextColor" Value="#FF5252" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Grid>
                                    </ViewCell>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Button Grid.Row="1" 
                                Text="+" 
                                VerticalOptions="End" 
                                HorizontalOptions="End" 
                                Margin="20" 
                                CornerRadius="30" 
                                WidthRequest="60" 
                                HeightRequest="60" 
                                BackgroundColor="#512BD4" 
                                FontSize="24" 
                                Clicked="OnAgregarMovimientoClicked"/>
                    </Grid>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>
    </Grid>
</ContentPage>