<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ControlGastosApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:ControlGastosApp.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="ControlGastosApp">

    <TabBar>

        <Tab Title="Diario">
            <ShellContent ContentTemplate="{DataTemplate views:MainPage}" Route="MainPage" />
        </Tab>

        <Tab Title="Servicios">
            <ShellContent ContentTemplate="{DataTemplate views:ServiciosPage}" Route="ServiciosPage" />
        </Tab>

    </TabBar>

</Shell>